{
  "compilerOptions": {
    "noImplicitThis": true,
    "strictNullChecks": true,
    "alwaysStrict": true,
    "target": "es2017",
    "module": "ESNext",
    "moduleResolution": "Node",
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "skipLibCheck": true,
    "outDir": "./lib",
    "rootDir": "src"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["lib", "cjs", "tests", "**/*.test.ts", "node_modules"]
}
